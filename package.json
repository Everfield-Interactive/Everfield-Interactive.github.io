{
  "name": "everfield-interactive-website",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "shots": "npm run build && npm run build:pages && node scripts/shots.mjs",
    "shots:lab": "node scripts/lab-shots.mjs",
    "licences": "node scripts/licences.mjs",
    "perf": "node scripts/later.mjs perf 2",
    "assets": "node scripts/later.mjs assets 2",
    "audio": "node scripts/later.mjs audio 6",
    "secrets:check": "node scripts/later.mjs secrets:check 3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/bodoni-moda": "5.3.0",
    "@fontsource-variable/cormorant": "5.3.0",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/eb-garamond": "5.3.0",
    "@fontsource-variable/jost": "5.3.0",
    "@fontsource/marcellus": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
  }
}
